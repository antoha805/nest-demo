PORT=3000
LOG_LEVEL=info
LOG_TRANSPORTS=pretty

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nest_demo

# Generate your own: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=3600

# The app's own URL, which links in mails start with.
APP_URL=http://localhost:3000
# smtp, ses or log. Leave empty to turn mail off.
MAIL_MAILER=log
# Used by the smtp and ses mailers.
# MAIL_FROM=nest-demo <noreply@example.com>
# Used by the smtp mailer.
# MAIL_URL=smtp://localhost:1025
# Used by the ses mailer and the sns SMS driver, with credentials from the AWS
# SDK, such as AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, or the EC2
# instance's role.
# AWS_REGION=eu-central-1

# sns, twilio or log. Leave empty to turn SMS off.
SMS_DRIVER=log
# Required by twilio: a number, a sender ID, or a messaging service SID (MG...).
# Optional for sns: a sender ID, where the country allows one.
# SMS_FROM=+15005550006
# Used by the twilio driver.
# TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# TWILIO_AUTH_TOKEN=
