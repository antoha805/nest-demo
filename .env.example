PORT=3000
LOG_LEVEL=info
LOG_TRANSPORTS=pretty

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nest_demo

# Generate your own: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=3600

# Where links in mails point, such as the frontend.
APP_URL=http://localhost:3000
# Without an SMTP server, mails are written to the log.
# MAIL_URL=smtp://localhost:1025
# MAIL_FROM=nest-demo <noreply@example.com>
